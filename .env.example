# Set these only in CloudBase service environment variables. Never commit real values.
PORT=8080
PUBLIC_ORIGIN=https://your-service-domain
DB_TRANSPORT=http
CLOUDBASE_ENV_ID=YOUR_ENVIRONMENT_ID
CLOUDBASE_API_KEY=SERVER_ONLY_ADMIN_API_KEY
# Optional direct-connection mode only: DB_TRANSPORT=postgres, DATABASE_URL, PG_SSL_MODE.
COS_REGION=ap-shanghai
COS_BUCKET=YOUR_PRIVATE_BUCKET
COS_SECRET_ID=RESTRICTED_SUBACCOUNT_ID
COS_SECRET_KEY=RESTRICTED_SUBACCOUNT_KEY
# Generate hashed account data with scripts/staff-config.mjs. No plaintext passwords in source.
STAFF_ACCOUNTS_JSON=[]
